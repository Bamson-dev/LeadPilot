# Copy to backend/.env.staging (gitignored) for local staging integration tests:
#   cd backend && node scripts/verify-outreach-staging.mjs
#
# Values from LeadPilot Staging → Project Settings → API
#
# IMPORTANT (RC1+): Coolify staging runs NODE_ENV=production (backend/Dockerfile:37).
# Do NOT set MOCK_OUTREACH_SEND, MOCK_MAILBOX_SMTP, ENABLE_TEST_EMAIL, or DEMO_MODE
# on the staging server — loadEnv() refuses them and API routes will not register.
# Local scripts may use mocks only when NODE_ENV=test/development in-process.

USE_REAL_SUPABASE=1
SUPABASE_URL=https://YOUR_LEADPILOT_STAGING_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
MAILBOX_ENCRYPTION_KEY=your_64_char_hex_key_here
# OUTREACH_TRACKING_BASE_URL=https://staging-backend.leadthur.com
# Comma-separated IPs that bypass per-IP rate limits for QA (does not bypass trial search limits).
RATE_LIMIT_IP_ALLOWLIST=162.120.188.117

# Optional: live Gmail SMTP connect test (staging server uses real SMTP — no MOCK_* on Coolify)
# GMAIL_TEST_EMAIL=you@gmail.com
# GMAIL_TEST_APP_PASSWORD=your16charapppass

# Optional: Paystack test secret for webhook simulation scripts
# PAYSTACK_SECRET_KEY=sk_test_...
